new file mode 100644
index 0000000..15d82d7
--- /dev/null
+++ b/vizcraft/crates/ai/src/brain/learners.rs
@@ -0,0 +1,498 @@
+//! The online learners of the personal brain. All train incrementally from single events, on
+//! device, and serialize to JSON.
+//!
+//! - [`ChartRecommender`]: contextual multinomial logistic regression (SGD) over field-type
+//!   features, initialised with visualization best practice, blended with Dirichlet counts per
+//!   exact context ("what this user picked for a date + a measure").
+//! - [`Preferences`]: decayed value counts per formatting key (labels on/off, legend position,
+//!   theme, title style…).
+//! - [`Sequences`]: an n-gram (trigram → bigram → unigram backoff) model of Power Query step
+//!   types per source kind.
+//! - [`Bandit`]: Thompson sampling over suggestion families, tuned by accept / dismiss.
+//! - [`MeasurePatterns`]: which DAX patterns the user writes (ratios, YoY, YTD, rankings…).
+
+use std::collections::BTreeMap;
+
+use serde::{Deserialize, Serialize};
+
+use super::features::{FieldSig, N_FEATURES, context_key, features};
+
+/// The chart types the recommender ranks (serde names of `VisualKind`).
+pub const CHART_CLASSES: &[&str] = &[
+    "clusteredColumn",
+    "clusteredBar",
+    "stackedColumn",
+    "line",
+    "area",
+    "pie",
+    "donut",
+    "treemap",
+    "scatter",
+    "card",
+    "multiRowCard",
+    "table",
+    "matrix",
+    "map",
+    "filledMap",
+    "waterfall",
+    "funnel",
+    "heatMap",
+    "kpi",
+    "gauge",
+    "histogram",
+    "lineClusteredColumn",
+];
+
+fn idx(name: &str) -> usize {
+    CHART_CLASSES.iter().position(|c| *c == name).unwrap_or(0)
+}
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct ChartRecommender {
+    /// weights[class][feature]
+    pub weights: Vec<Vec<f64>>,
+    /// context key → class → count
+    pub counts: BTreeMap<String, BTreeMap<String, f64>>,
+    pub updates: u64,
+    pub learning_rate: f64,
+    /// Prior strength of the logistic model against the counts (pseudo-observations).
+    pub alpha: f64,
+}
+
+impl Default for ChartRecommender {
+    fn default() -> Self {
+        let mut w = vec![vec![0.0; N_FEATURES]; CHART_CLASSES.len()];
+        // Best-practice prior: feature index from FEATURE_NAMES.
+        let mut set = |class: &str, f: usize, v: f64| {
+            if let Some(row) = w.get_mut(idx(class))
+                && let Some(x) = row.get_mut(f)
+            {
+                *x += v;
+            }
+        };
+        // 0 bias, 1 date, 2 m=1, 3 m=2, 4 m>=3, 5 cats=0, 6 cats=1, 7 cats>=2, 8 geo, 9 id, 10 low, 11 mid, 12 high, 13 only values, 14 bool
+        set("clusteredColumn", 0, 0.6);
+        set("clusteredColumn", 6, 1.2);
+        set("clusteredColumn", 10, 0.6);
+        set("clusteredBar", 6, 1.1);
+        set("clusteredBar", 11, 1.0);
+        set("clusteredBar", 12, 0.6);
+        set("stackedColumn", 7, 1.2);
+        set("stackedColumn", 1, 0.3);
+        set("line", 1, 2.4);
+        set("line", 7, -0.4);
+        set("area", 1, 1.3);
+        set("pie", 10, 0.9);
+        set("pie", 6, 0.4);
+        set("pie", 3, -1.0);
+        set("donut", 10, 0.8);
+        set("donut", 6, 0.3);
+        set("treemap", 12, 0.7);
+        set("treemap", 6, 0.3);
+        set("scatter", 3, 1.6);
+        set("scatter", 9, 0.4);
+        set("card", 13, 2.2);
+        set("card", 2, 0.5);
+        set("multiRowCard", 13, 1.0);
+        set("multiRowCard", 4, 1.2);
+        set("table", 9, 1.4);
+        set("table", 4, 0.8);
+        set("table", 12, 0.6);
+        set("matrix", 7, 1.0);
+        set("matrix", 4, 0.6);
+        set("map", 8, 2.0);
+        set("filledMap", 8, 1.2);
+        set("waterfall", 1, 0.2);
+        set("funnel", 10, 0.3);
+        set("heatMap", 7, 0.7);
+        set("kpi", 13, 0.6);
+        set("kpi", 1, 0.3);
+        set("gauge", 13, 0.5);
+        set("histogram", 5, 0.2);
+        set("lineClusteredColumn", 1, 0.6);
+        set("lineClusteredColumn", 3, 1.0);
+        for row in w.iter_mut() {
+            if let Some(b) = row.get_mut(0) {
+                *b -= 0.5;
+            }
+        }
+        ChartRecommender { weights: w, counts: BTreeMap::new(), updates: 0, learning_rate: 0.15, alpha: 4.0 }
+    }
+}
+
+pub fn softmax(z: &[f64]) -> Vec<f64> {
+    let m = z.iter().cloned().fold(f64::MIN, f64::max);
+    let e: Vec<f64> = z.iter().map(|x| (x - m).exp()).collect();
+    let s: f64 = e.iter().sum::<f64>().max(1e-12);
+    e.iter().map(|x| x / s).collect()
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct ChartScore {
+    pub kind: String,
+    pub prob: f64,
+    /// Share of this choice among the user's own choices in this context, and how many.
+    pub personal_share: f64,
+    pub personal_n: f64,
+}
+
+impl ChartRecommender {
+    fn logits(&self, x: &[f64; N_FEATURES]) -> Vec<f64> {
+        self.weights.iter().map(|w| w.iter().zip(x.iter()).map(|(a, b)| a * b).sum()).collect()
+    }
+
+    pub fn lr_probs(&self, fields: &[FieldSig]) -> Vec<f64> {
+        softmax(&self.logits(&features(fields)))
+    }
+
+    /// Ranked chart types for these fields.
+    pub fn rank(&self, fields: &[FieldSig]) -> Vec<ChartScore> {
+        let p = self.lr_probs(fields);
+        let key = context_key(fields);
+        let counts = self.counts.get(&key);
+        let n: f64 = counts.map(|c| c.values().sum()).unwrap_or(0.0);
+        let mut out: Vec<ChartScore> = CHART_CLASSES
+            .iter()
+            .enumerate()
+            .map(|(i, k)| {
+                let c = counts.and_then(|m| m.get(*k)).copied().unwrap_or(0.0);
+                let lr = p.get(i).copied().unwrap_or(0.0);
+                let prob = (c + self.alpha * lr) / (n + self.alpha);
+                ChartScore { kind: k.to_string(), prob, personal_share: if n > 0.0 { c / n } else { 0.0 }, personal_n: n }
+            })
+            .collect();
+        out.sort_by(|a, b| b.prob.partial_cmp(&a.prob).unwrap_or(std::cmp::Ordering::Equal));
+        out
+    }
+
+    /// One SGD step of cross-entropy towards `chosen`, and a count.
+    pub fn learn(&mut self, fields: &[FieldSig], chosen: &str, weight: f64) {
+        let Some(ci) = CHART_CLASSES.iter().position(|c| *c == chosen) else { return };
+        let x = features(fields);
+        let p = softmax(&self.logits(&x));
+        let lr = self.learning_rate * weight / (1.0 + self.updates as f64 / 500.0);
+        for (k, row) in self.weights.iter_mut().enumerate() {
+            let g = p.get(k).copied().unwrap_or(0.0) - if k == ci { 1.0 } else { 0.0 };
+            for (w, xi) in row.iter_mut().zip(x.iter()) {
+                *w -= lr * g * xi;
+            }
+        }
+        *self.counts.entry(context_key(fields)).or_default().entry(chosen.to_string()).or_default() += weight;
+        self.updates += 1;
+    }
+}
+
+/// Decayed counts of values per formatting key.
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Preferences {
+    /// "scope|key" → value → weight. Scope is a visual kind or "report".
+    pub values: BTreeMap<String, BTreeMap<String, f64>>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Pref {
+    pub scope: String,
+    pub key: String,
+    pub value: String,
+    pub share: f64,
+    pub n: f64,
+}
+
+impl Preferences {
+    pub const DECAY: f64 = 0.97;
+
+    pub fn learn(&mut self, scope: &str, key: &str, value: &str) {
+        let m = self.values.entry(format!("{scope}|{key}")).or_default();
+        for v in m.values_mut() {
+            *v *= Self::DECAY;
+        }
+        *m.entry(value.to_string()).or_default() += 1.0;
+        // Also learn across all visuals.
+        if scope != "*" && scope != "report" {
+            let m = self.values.entry(format!("*|{key}")).or_default();
+            for v in m.values_mut() {
+                *v *= Self::DECAY;
+            }
+            *m.entry(value.to_string()).or_default() += 1.0;
+        }
+    }
+
+    /// The dominant value of each key for `scope` (falling back to all visuals), when it is a
+    /// clear habit (share ≥ `min_share`, weight ≥ `min_n`).
+    pub fn habits(&self, scope: &str, min_share: f64, min_n: f64) -> Vec<Pref> {
+        let mut out: BTreeMap<String, Pref> = BTreeMap::new();
+        for s in ["*", scope] {
+            for (k, vals) in self.values.iter().filter(|(k, _)| k.starts_with(&format!("{s}|"))) {
+                let n: f64 = vals.values().sum();
+                if let Some((v, w)) = vals.iter().max_by(|a, b| a.1.partial_cmp(b.1).unwrap_or(std::cmp::Ordering::Equal)) {
+                    let share = w / n.max(1e-9);
+                    if share >= min_share && n >= min_n {
+                        let key = k.split_once('|').map(|x| x.1).unwrap_or("").to_string();
+                        out.insert(key.clone(), Pref { scope: s.to_string(), key, value: v.clone(), share, n });
+                    }
+                }
+            }
+        }
+        out.into_values().collect()
+    }
+}
+
+/// N-gram model of transform steps per source kind.
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Sequences {
+    /// "source|prev2|prev1" → next → count (prev2 / prev1 may be "^" for the start).
+    pub trigrams: BTreeMap<String, BTreeMap<String, f64>>,
+    pub bigrams: BTreeMap<String, BTreeMap<String, f64>>,
+    pub unigrams: BTreeMap<String, BTreeMap<String, f64>>,
+    /// Source kinds used (csv, excel, sql, web…).
+    pub sources: BTreeMap<String, f64>,
+}
+
+impl Sequences {
+    pub fn learn(&mut self, source: &str, history: &[String], step: &str) {
+        let p1 = history.last().map(String::as_str).unwrap_or("^");
+        let p2 = if history.len() >= 2 { history.get(history.len() - 2).map(String::as_str).unwrap_or("^") } else { "^" };
+        *self.trigrams.entry(format!("{source}|{p2}|{p1}")).or_default().entry(step.into()).or_default() += 1.0;
+        *self.bigrams.entry(format!("{source}|{p1}")).or_default().entry(step.into()).or_default() += 1.0;
+        *self.unigrams.entry(source.to_string()).or_default().entry(step.into()).or_default() += 1.0;
+    }
+
+    /// Next-step probabilities (interpolated trigram/bigram/unigram).
+    pub fn predict(&self, source: &str, history: &[String]) -> Vec<(String, f64)> {
+        let p1 = history.last().map(String::as_str).unwrap_or("^");
+        let p2 = if history.len() >= 2 { history.get(history.len() - 2).map(String::as_str).unwrap_or("^") } else { "^" };
+        let mut scores: BTreeMap<String, f64> = BTreeMap::new();
+        let mut add = |m: Option<&BTreeMap<String, f64>>, w: f64| {
+            if let Some(m) = m {
+                let n: f64 = m.values().sum();
+                if n > 0.0 {
+                    for (k, c) in m {
+                        *scores.entry(k.clone()).or_default() += w * c / n;
+                    }
+                }
+            }
+        };
+        add(self.trigrams.get(&format!("{source}|{p2}|{p1}")), 0.6);
+        add(self.bigrams.get(&format!("{source}|{p1}")), 0.3);
+        add(self.unigrams.get(source), 0.1);
+        let total: f64 = scores.values().sum();
+        let mut v: Vec<(String, f64)> = scores.into_iter().map(|(k, s)| (k, if total > 0.0 { s / total } else { 0.0 })).collect();
+        v.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));
+        v
+    }
+}
+
+/// Thompson sampling with Beta(1 + accepts, 1 + rejects) per suggestion family.
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Bandit {
+    pub arms: BTreeMap<String, (f64, f64)>,
+}
+
+/// A small deterministic PRNG (xorshift64*), seeded from the clock in the app.
+#[derive(Clone, Debug)]
+pub struct Rng(pub u64);
+
+impl Rng {
+    pub fn next_u64(&mut self) -> u64 {
+        let mut x = self.0.max(1);
+        x ^= x >> 12;
+        x ^= x << 25;
+        x ^= x >> 27;
+        self.0 = x;
+        x.wrapping_mul(0x2545_F491_4F6C_DD1D)
+    }
+    pub fn uniform(&mut self) -> f64 {
+        ((self.next_u64() >> 11) as f64 + 0.5) / (1u64 << 53) as f64
+    }
+    pub fn normal(&mut self) -> f64 {
+        let (u1, u2) = (self.uniform(), self.uniform());
+        (-2.0 * u1.ln()).sqrt() * (2.0 * std::f64::consts::PI * u2).cos()
+    }
+    /// Gamma(shape, 1) by Marsaglia–Tsang.
+    pub fn gamma(&mut self, shape: f64) -> f64 {
+        if shape < 1.0 {
+            let u = self.uniform();
+            return self.gamma(shape + 1.0) * u.powf(1.0 / shape);
+        }
+        let d = shape - 1.0 / 3.0;
+        let c = 1.0 / (9.0 * d).sqrt();
+        loop {
+            let x = self.normal();
+            let v = (1.0 + c * x).powi(3);
+            if v <= 0.0 {
+                continue;
+            }
+            let u = self.uniform();
+            if u.ln() < 0.5 * x * x + d - d * v + d * v.ln() {
+                return d * v;
+            }
+        }
+    }
+    pub fn beta(&mut self, a: f64, b: f64) -> f64 {
+        let x = self.gamma(a.max(1e-3));
+        let y = self.gamma(b.max(1e-3));
+        x / (x + y).max(1e-12)
+    }
+}
+
+impl Bandit {
+    pub fn learn(&mut self, arm: &str, accepted: bool) {
+        let e = self.arms.entry(arm.to_string()).or_insert((0.0, 0.0));
+        if accepted {
+            e.0 += 1.0;
+        } else {
+            e.1 += 1.0;
+        }
+    }
+    pub fn mean(&self, arm: &str) -> f64 {
+        let (a, r) = self.arms.get(arm).copied().unwrap_or((0.0, 0.0));
+        (1.0 + a) / (2.0 + a + r)
+    }
+    pub fn sample(&self, arm: &str, rng: &mut Rng) -> f64 {
+        let (a, r) = self.arms.get(arm).copied().unwrap_or((0.0, 0.0));
+        rng.beta(1.0 + a, 1.0 + r)
+    }
+}
+
+/// DAX pattern classes and how often the user writes them.
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct MeasurePatterns {
+    pub counts: BTreeMap<String, f64>,
+    /// Format strings used for measures of each pattern.
+    pub formats: BTreeMap<String, BTreeMap<String, f64>>,
+}
+
+pub fn dax_pattern(dax: &str) -> &'static str {
+    let d = dax.to_uppercase();
+    if ["SAMEPERIODLASTYEAR", "DATEADD", "PARALLELPERIOD", "PREVIOUSYEAR"].iter().any(|f| d.contains(f)) {
+        "year-over-year"
+    } else if ["TOTALYTD", "DATESYTD", "TOTALQTD", "TOTALMTD", "DATESMTD"].iter().any(|f| d.contains(f)) {
+        "period-to-date"
+    } else if d.contains("RANKX") || d.contains("TOPN") {
+        "ranking"
+    } else if d.contains("DIVIDE") || d.contains(" / ") || d.contains(")/") {
+        "ratio"
+    } else if d.contains("CALCULATE") && (d.contains("ALL(") || d.contains("ALLSELECTED") || d.contains("REMOVEFILTERS")) {
+        "share-of-total"
+    } else if d.contains("CALCULATE") {
+        "filtered"
+    } else if ["SUMX", "AVERAGEX", "MAXX", "MINX", "COUNTX"].iter().any(|f| d.contains(f)) {
+        "iterator"
+    } else if d.contains("DISTINCTCOUNT") || d.contains("COUNTROWS") || d.contains("COUNT(") {
+        "count"
+    } else if d.contains("AVERAGE") {
+        "average"
+    } else if d.contains("SUM(") {
+        "sum"
+    } else {
+        "other"
+    }
+}
+
+impl MeasurePatterns {
+    pub fn learn(&mut self, dax: &str, format: &str) {
+        let p = dax_pattern(dax);
+        *self.counts.entry(p.to_string()).or_default() += 1.0;
+        if !format.is_empty() {
+            *self.formats.entry(p.to_string()).or_default().entry(format.to_string()).or_default() += 1.0;
+        }
+    }
+
+    /// A DAX template of `pattern` built on `base` (a measure name), with the usual format.
+    pub fn template(&self, pattern: &str, base: &str, date_col: Option<&str>) -> Option<(String, String, String)> {
+        let fmt = |dflt: &str| self.formats.get(pattern).and_then(|m| m.iter().max_by(|a, b| a.1.partial_cmp(b.1).unwrap_or(std::cmp::Ordering::Equal))).map(|(f, _)| f.clone()).unwrap_or_else(|| dflt.to_string());
+        let m = format!("[{base}]");
+        Some(match pattern {
+            "year-over-year" => {
+                let d = date_col?;
+                (format!("{base} YoY %"), format!("VAR prev = CALCULATE({m}, SAMEPERIODLASTYEAR({d})) RETURN DIVIDE({m} - prev, prev)"), fmt("0.0%"))
+            }
+            "period-to-date" => {
+                let d = date_col?;
+                (format!("{base} YTD"), format!("TOTALYTD({m}, {d})"), fmt("#,0"))
+            }
+            "share-of-total" | "ratio" => (format!("{base} % of total"), format!("DIVIDE({m}, CALCULATE({m}, ALLSELECTED()))"), fmt("0.0%")),
+            "ranking" => return None,
+            _ => return None,
+        })
+    }
+
+    pub fn top(&self) -> Vec<(String, f64)> {
+        let mut v: Vec<(String, f64)> = self.counts.iter().map(|(k, c)| (k.clone(), *c)).collect();
+        v.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));
+        v
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn date_measure() -> Vec<FieldSig> {
+        vec![FieldSig::new("date", "Date"), FieldSig::new("measure", "Sales")]
+    }
+
+    #[test]
+    fn prior_is_best_practice_and_learning_moves_it() {
+        let mut r = ChartRecommender::default();
+        assert_eq!(r.rank(&date_measure())[0].kind, "line");
+        assert_eq!(r.rank(&[FieldSig::new("measure", "Sales")])[0].kind, "card");
+        let cat = vec![FieldSig { ty: "category".into(), name: "Product".into(), card: "mid".into() }, FieldSig::new("measure", "Sales")];
+        assert!(["clusteredBar", "clusteredColumn"].contains(&r.rank(&cat)[0].kind.as_str()));
+        assert_eq!(r.rank(&[FieldSig::new("geo", "Country"), FieldSig::new("measure", "S")])[0].kind, "map");
+        // This user always makes area charts for dates.
+        for _ in 0..12 {
+            r.learn(&date_measure(), "area", 1.0);
+        }
+        let top = &r.rank(&date_measure())[0];
+        assert_eq!(top.kind, "area");
+        assert!(top.personal_share > 0.99 && top.personal_n >= 12.0);
+        // The logistic part generalises to a similar context (date + 2 measures).
+        let ctx2 = vec![FieldSig::new("date", "Date"), FieldSig::new("measure", "A"), FieldSig::new("measure", "B")];
+        let p = r.lr_probs(&ctx2);
+        assert!(p[idx("area")] > ChartRecommender::default().lr_probs(&ctx2)[idx("area")]);
+    }
+
+    #[test]
+    fn preferences_sequences_bandit_patterns() {
+        let mut p = Preferences::default();
+        for _ in 0..5 {
+            p.learn("line", "labels.show", "true");
+        }
+        p.learn("line", "labels.show", "false");
+        let h = p.habits("line", 0.6, 3.0);
+        assert!(h.iter().any(|x| x.key == "labels.show" && x.value == "true"));
+        assert!(p.habits("pie", 0.6, 3.0).iter().any(|x| x.key == "labels.show"), "global habits apply to other visuals");
+
+        let mut s = Sequences::default();
+        for _ in 0..4 {
+            s.learn("csv", &[], "PromoteHeaders");
+            s.learn("csv", &["PromoteHeaders".into()], "ChangeType");
+            s.learn("csv", &["PromoteHeaders".into(), "ChangeType".into()], "RemoveColumns");
+        }
+        assert_eq!(s.predict("csv", &[]).first().map(|x| x.0.as_str()), Some("PromoteHeaders"));
+        assert_eq!(s.predict("csv", &["PromoteHeaders".into(), "ChangeType".into()])[0].0, "RemoveColumns");
+
+        let mut b = Bandit::default();
+        for _ in 0..20 {
+            b.learn("format", false);
+            b.learn("chart", true);
+        }
+        let mut rng = Rng(42);
+        let wins = (0..200).filter(|_| b.sample("chart", &mut rng) > b.sample("format", &mut rng)).count();
+        assert!(wins > 180, "{wins}");
+        assert!(b.mean("chart") > 0.9);
+
+        let mut m = MeasurePatterns::default();
+        m.learn("DIVIDE([Profit], [Sales])", "0.0%");
+        m.learn("CALCULATE([Sales], SAMEPERIODLASTYEAR('Date'[Date]))", "");
+        assert_eq!(dax_pattern("TOTALYTD([S], 'D'[D])"), "period-to-date");
+        assert_eq!(m.template("ratio", "Sales", None).map(|t| t.2), Some("0.0%".into()));
+        assert!(m.template("year-over-year", "Sales", Some("Sales[Date]")).is_some());
+    }
+}
diff --git a/vizcraft/crates/ai/src/brain/memory.rs b/vizcraft/crates/ai/src/brain/memory.rs
new file mode 100644
index 0000000..69df55c
--- /dev/null
+++ b/vizcraft/crates/ai/src/brain/memory.rs
@@ -0,0 +1,127 @@
+//! Memory of the user's past questions and how they were resolved, searched with BM25 (and,
+//! optionally, cosine similarity over embeddings a provider computed).
+
+use std::collections::BTreeMap;
+
+use serde::{Deserialize, Serialize};
+
+use crate::decide::tokens;
+
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", default)]
+pub struct MemoryItem {
+    pub question: String,
+    /// What answered it: a chart spec, a DAX query, the copilot's answer…
+    pub resolution: String,
+    pub accepted: bool,
+    pub ts: f64,
+    /// Optional embedding of the question.
+    #[serde(skip_serializing_if = "Vec::is_empty")]
+    pub embedding: Vec<f32>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Memory {
+    pub items: Vec<MemoryItem>,
+    /// term → number of items containing it.
+    pub df: BTreeMap<String, usize>,
+    pub total_len: usize,
+}
+
+const K1: f64 = 1.2;
+const B: f64 = 0.75;
+const MAX_ITEMS: usize = 5000;
+
+impl Memory {
+    pub fn add(&mut self, item: MemoryItem) {
+        let toks = tokens(&item.question);
+        let uniq: std::collections::BTreeSet<&String> = toks.iter().collect();
+        for t in uniq {
+            *self.df.entry(t.clone()).or_default() += 1;
+        }
+        self.total_len += toks.len();
+        self.items.push(item);
+        if self.items.len() > MAX_ITEMS {
+            let old = self.items.remove(0);
+            let toks = tokens(&old.question);
+            let uniq: std::collections::BTreeSet<&String> = toks.iter().collect();
+            for t in uniq {
+                if let Some(c) = self.df.get_mut(t) {
+                    *c = c.saturating_sub(1);
+                }
+            }
+            self.total_len = self.total_len.saturating_sub(toks.len());
+        }
+    }
+
+    pub fn bm25(&self, query: &str, item: &MemoryItem) -> f64 {
+        let n = self.items.len().max(1) as f64;
+        let avg = (self.total_len as f64 / n).max(1.0);
+        let doc = tokens(&item.question);
+        let dl = doc.len() as f64;
+        let mut score = 0.0;
+        let q: std::collections::BTreeSet<String> = tokens(query).into_iter().collect();
+        for t in &q {
+            let tf = doc.iter().filter(|d| *d == t).count() as f64;
+            if tf == 0.0 {
+                continue;
+            }
+            let df = self.df.get(t).copied().unwrap_or(0) as f64;
+            let idf = ((n - df + 0.5) / (df + 0.5) + 1.0).ln();
+            score += idf * tf * (K1 + 1.0) / (tf + K1 * (1.0 - B + B * dl / avg));
+        }
+        score
+    }
+
+    /// The `k` best-matching past questions (accepted resolutions weigh more), with scores.
+    pub fn recall(&self, query: &str, k: usize, query_embedding: Option<&[f32]>) -> Vec<(MemoryItem, f64)> {
+        let mut v: Vec<(MemoryItem, f64)> = self
+            .items
+            .iter()
+            .map(|it| {
+                let mut s = self.bm25(query, it);
+                if let Some(qe) = query_embedding
+                    && !it.embedding.is_empty()
+                {
+                    s += 3.0 * cosine(qe, &it.embedding).max(0.0);
+                }
+                if it.accepted {
+                    s *= 1.25;
+                }
+                (it.clone(), s)
+            })
+            .filter(|(_, s)| *s > 0.0)
+            .collect();
+        v.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));
+        v.truncate(k);
+        v
+    }
+}
+
+pub fn cosine(a: &[f32], b: &[f32]) -> f64 {
+    let (mut d, mut na, mut nb) = (0.0f64, 0.0f64, 0.0f64);
+    for (x, y) in a.iter().zip(b.iter()) {
+        d += f64::from(*x) * f64::from(*y);
+        na += f64::from(*x) * f64::from(*x);
+        nb += f64::from(*y) * f64::from(*y);
+    }
+    if na == 0.0 || nb == 0.0 { 0.0 } else { d / (na.sqrt() * nb.sqrt()) }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn bm25_recall() {
+        let mut m = Memory::default();
+        for (q, r) in [("total sales by region", "column chart Region × Total Sales"), ("profit margin per product category", "measure Margin = DIVIDE"), ("how many customers per month", "line chart")] {
+            m.add(MemoryItem { question: q.into(), resolution: r.into(), accepted: true, ..Default::default() });
+        }
+        let r = m.recall("sales by region last year", 2, None);
+        assert_eq!(r[0].0.question, "total sales by region");
+        assert!(m.recall("zebra", 3, None).is_empty());
+        assert!((cosine(&[1.0, 0.0], &[1.0, 0.0]) - 1.0).abs() < 1e-9);
+    }
+}
diff --git a/vizcraft/crates/ai/src/brain/mod.rs b/vizcraft/crates/ai/src/brain/mod.rs
new file mode 100644
index 0000000..3f9c0d0
--- /dev/null
+++ b/vizcraft/crates/ai/src/brain/mod.rs
@@ -0,0 +1,552 @@
+//! The personal brain: every installed copy of VizCraft becomes its own learning model.
+//!
+//! Like an ad account that learns from every campaign, the brain learns from what this user
+//! does: which visuals they build from which kinds of fields, how they format them, which Power
+//! Query steps follow which, which DAX patterns they write, which questions they ask and which
+//! suggestions they accept. It is:
+//!
+//! - **local**: an append-only log in `~/.vizcraft/brain/events.jsonl` and model weights in
+//!   `~/.vizcraft/brain/model.json`; nothing leaves the machine;
+//! - **online**: each event updates the learners immediately (no batch training);
+//! - **explainable**: every suggestion says why ("you made a line chart for a date and a measure
+//!   in 9 of 11 cases");
+//! - **opt-in**: learning can be switched off, the log exported, and everything forgotten.
+
+pub mod features;
+pub mod learners;
+pub mod memory;
+
+use std::collections::BTreeMap;
+use std::io::Write;
+use std::path::PathBuf;
+
+use serde::{Deserialize, Serialize};
+
+pub use features::FieldSig;
+use learners::{Bandit, ChartRecommender, MeasurePatterns, Preferences, Rng, Sequences};
+use memory::{Memory, MemoryItem};
+
+use crate::decide::LocalDecider;
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", tag = "type")]
+pub enum EventKind {
+    /// A visual was created or its type chosen for a set of fields. `source`: "gallery",
+    /// "copilot", "formulator", "suggestion", "qna".
+    VisualCreated { kind: String, fields: Vec<FieldSig>, source: String },
+    /// The user changed a visual's type (a strong signal: the new type is preferred).
+    VisualKindChanged { from: String, to: String, fields: Vec<FieldSig> },
+    FieldAdded { visual: String, role: String, field: FieldSig },
+    /// A formatting property set by hand (`scope` = visual kind, "page" or "report").
+    Format { scope: String, key: String, value: String },
+    Theme { name: String },
+    Filter { field: FieldSig, kind: String },
+    Measure { name: String, dax: String, format: String },
+    Relationship { from: String, to: String },
+    Page { kind: String },
+    /// A Power Query step (`step` = the step type, e.g. "RemoveColumns") on a source kind.
+    Transform { source: String, history: Vec<String>, step: String },
+    Source { kind: String },
+    /// A question (copilot, Q&A, Formulator) and what resolved it.
+    Question { text: String, resolution: String, accepted: bool },
+    /// A suggestion shown to the user was accepted or dismissed.
+    Suggestion { arm: String, id: String, accepted: bool },
+    /// A typed decision (for the local decision backend's priors).
+    Decision { key: String, choice: String },
+}
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Event {
+    pub ts: f64,
+    /// Local hour of day (0–23).
+    pub hour: u8,
+    #[serde(flatten)]
+    pub kind: EventKind,
+}
+
+impl Event {
+    pub fn now(kind: EventKind) -> Event {
+        let now = chrono::Local::now();
+        use chrono::Timelike;
+        Event { ts: now.timestamp_millis() as f64 / 1000.0, hour: now.hour() as u8, kind }
+    }
+    pub fn name(&self) -> &'static str {
+        match &self.kind {
+            EventKind::VisualCreated { .. } => "visual created",
+            EventKind::VisualKindChanged { .. } => "visual type changed",
+            EventKind::FieldAdded { .. } => "field added",
+            EventKind::Format { .. } => "format",
+            EventKind::Theme { .. } => "theme",
+            EventKind::Filter { .. } => "filter",
+            EventKind::Measure { .. } => "measure",
+            EventKind::Relationship { .. } => "relationship",
+            EventKind::Page { .. } => "page",
+            EventKind::Transform { .. } => "transform",
+            EventKind::Source { .. } => "data source",
+            EventKind::Question { .. } => "question",
+            EventKind::Suggestion { .. } => "suggestion",
+            EventKind::Decision { .. } => "decision",
+        }
+    }
+}
+
+/// Everything learned, serialized to `model.json`.
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct BrainModel {
+    pub version: u32,
+    pub charts: ChartRecommender,
+    pub prefs: Preferences,
+    pub sequences: Sequences,
+    pub memory: Memory,
+    pub bandit: Bandit,
+    pub measures: MeasurePatterns,
+    /// Decision key → option → count (priors for the local decider).
+    pub decisions: BTreeMap<String, BTreeMap<String, f64>>,
+    /// Event counts by type and by hour.
+    pub counts: BTreeMap<String, u64>,
+    pub hours: Vec<u64>,
+    pub events: u64,
+    pub first_ts: f64,
+    pub last_ts: f64,
+}
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", tag = "type")]
+pub enum SuggestionAction {
+    ChartType { kind: String },
+    Format { key: String, value: String },
+    Theme { name: String },
+    Transform { step: String },
+    Measure { name: String, dax: String, format: String },
+    Recall { question: String, resolution: String },
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Suggestion {
+    pub id: String,
+    /// The bandit arm (family): "chart", "format", "theme", "transform", "measure", "recall".
+    pub arm: String,
+    pub title: String,
+    /// Why ("you made a line chart for a date and a measure in 9 of 11 cases").
+    pub why: String,
+    pub score: f64,
+    pub action: SuggestionAction,
+}
+
+/// What the user is doing now.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct SuggestContext {
+    pub fields: Vec<FieldSig>,
+    pub visual_kind: Option<String>,
+    pub source_kind: Option<String>,
+    pub last_steps: Vec<String>,
+    pub question: Option<String>,
+    /// A measure the user is working with and a date column (for measure templates).
+    pub measure: Option<String>,
+    pub date_column: Option<String>,
+    /// Format values already set on the visual (key → value): habits already applied are skipped.
+    pub current_format: BTreeMap<String, String>,
+    pub max: usize,
+}
+
+pub struct Brain {
+    pub dir: Option<PathBuf>,
+    pub enabled: bool,
+    pub model: BrainModel,
+    rng: Rng,
+    unsaved: usize,
+}
+
+impl Brain {
+    /// An in-memory brain (tests, or when the home directory isn't writable).
+    pub fn in_memory() -> Brain {
+        Brain { dir: None, enabled: true, model: BrainModel { version: 1, hours: vec![0; 24], ..BrainModel::default() }, rng: Rng(0x9E37_79B9_7F4A_7C15), unsaved: 0 }
+    }
+
+    pub fn default_dir() -> PathBuf {
+        crate::home_dir().join("brain")
+    }
+
+    /// Opens the brain in `dir`: loads `model.json`, or rebuilds it by replaying `events.jsonl`.
+    pub fn open(dir: PathBuf, enabled: bool) -> Brain {
+        let mut b = Brain::in_memory();
+        b.enabled = enabled;
+        b.rng = Rng(std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_nanos() as u64).unwrap_or(7) | 1);
+        if let Some(m) = std::fs::read_to_string(dir.join("model.json")).ok().and_then(|t| serde_json::from_str::<BrainModel>(&t).ok()) {
+            b.model = m;
+            if b.model.hours.len() != 24 {
+                b.model.hours = vec![0; 24];
+            }
+        } else {
+            for e in read_events(&dir.join("events.jsonl")) {
+                b.learn(&e);
+            }
+        }
+        b.dir = Some(dir);
+        b
+    }
+
+    pub fn events_path(&self) -> Option<PathBuf> {
+        self.dir.as_ref().map(|d| d.join("events.jsonl"))
+    }
+
+    /// Records an action: appends it to the log and learns from it (when learning is on).
+    pub fn record(&mut self, kind: EventKind) {
+        if !self.enabled {
+            return;
+        }
+        let e = Event::now(kind);
+        if let Some(p) = self.events_path() {
+            if let Some(d) = p.parent() {
+                let _ = std::fs::create_dir_all(d);
+            }
+            if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(&p)
+                && let Ok(line) = serde_json::to_string(&e)
+            {
+                let _ = writeln!(f, "{line}");
+            }
+        }
+        self.learn(&e);
+        self.unsaved += 1;
+        if self.unsaved >= 10 {
+            self.save();
+        }
+    }
+
+    /// Online update of every learner from one event.
+    pub fn learn(&mut self, e: &Event) {
+        let m = &mut self.model;
+        m.events += 1;
+        if m.first_ts == 0.0 {
+            m.first_ts = e.ts;
+        }
+        m.last_ts = e.ts;
+        *m.counts.entry(e.name().to_string()).or_default() += 1;
+        if m.hours.len() != 24 {
+            m.hours = vec![0; 24];
+        }
+        if let Some(h) = m.hours.get_mut(usize::from(e.hour.min(23))) {
+            *h += 1;
+        }
+        match &e.kind {
+            EventKind::VisualCreated { kind, fields, source } => {
+                if !fields.is_empty() {
+                    // Charts the AI made count less than the user's own choices.
+                    let w = if source == "copilot" { 0.5 } else { 1.0 };
+                    m.charts.learn(fields, kind, w);
+                }
+            }
+            EventKind::VisualKindChanged { to, fields, .. } => {
+                if !fields.is_empty() {
+                    m.charts.learn(fields, to, 1.5);
+                }
+            }
+            EventKind::FieldAdded { .. } | EventKind::Filter { .. } | EventKind::Relationship { .. } | EventKind::Page { .. } => {}
+            EventKind::Format { scope, key, value } => m.prefs.learn(scope, key, value),
+            EventKind::Theme { name } => m.prefs.learn("report", "theme", name),
+            EventKind::Measure { dax, format, .. } => m.measures.learn(dax, format),
+            EventKind::Transform { source, history, step } => m.sequences.learn(source, history, step),
+            EventKind::Source { kind } => *m.sequences.sources.entry(kind.clone()).or_default() += 1.0,
+            EventKind::Question { text, resolution, accepted } => m.memory.add(MemoryItem { question: text.clone(), resolution: resolution.clone(), accepted: *accepted, ts: e.ts, embedding: vec![] }),
+            EventKind::Suggestion { arm, accepted, .. } => m.bandit.learn(arm, *accepted),
+            EventKind::Decision { key, choice } => *m.decisions.entry(key.clone()).or_default().entry(choice.clone()).or_default() += 1.0,
+        }
+    }
+
+    pub fn save(&mut self) {
+        self.unsaved = 0;
+        let Some(dir) = &self.dir else { return };
+        let _ = std::fs::create_dir_all(dir);
+        if let Ok(t) = serde_json::to_string(&self.model) {
+            let tmp = dir.join("model.json.tmp");
+            if std::fs::write(&tmp, t).is_ok() {
+                let _ = std::fs::rename(&tmp, dir.join("model.json"));
+            }
+        }
+    }
+
+    /// Deletes the log and the learned model.
+    pub fn forget(&mut self) {
+        if let Some(dir) = &self.dir {
+            let _ = std::fs::remove_file(dir.join("events.jsonl"));
+            let _ = std::fs::remove_file(dir.join("model.json"));
+        }
+        self.model = Brain::in_memory().model;
+        self.unsaved = 0;
+    }
+
+    /// Copies the event log to `path`.
+    pub fn export_events(&self, path: &std::path::Path) -> Result<usize, String> {
+        let events = self.events();
+        let text: String = events.iter().filter_map(|e| serde_json::to_string(e).ok()).map(|l| l + "\n").collect();
+        std::fs::write(path, text).map_err(|e| e.to_string())?;
+        Ok(events.len())
+    }
+
+    pub fn events(&self) -> Vec<Event> {
+        self.events_path().map(|p| read_events(&p)).unwrap_or_default()
+    }
+
+    // ---------------------------------------------------------------- inference
+
+    /// Ranked chart types for fields, with explanations.
+    pub fn recommend_chart(&self, fields: &[FieldSig], k: usize) -> Vec<Suggestion> {
+        let phrase = features::context_phrase(fields);
+        self.model
+            .charts
+            .rank(fields)
+            .into_iter()
+            .take(k)
+            .map(|c| {
+                let label = kind_label(&c.kind);
+                let why = if c.personal_n >= 2.0 && c.personal_share > 0.0 {
+                    format!("You used a {} for {phrase} {:.0}% of the time ({} of {}).", label.to_lowercase(), c.personal_share * 100.0, (c.personal_share * c.personal_n).round(), c.personal_n.round())
+                } else {
+                    format!("A good fit for {phrase}.")
+                };
+                Suggestion { id: format!("chart:{}", c.kind), arm: "chart".into(), title: label, why, score: c.prob, action: SuggestionAction::ChartType { kind: c.kind } }
+            })
+            .collect()
+    }
+
+    /// Suggestions for the current context, ranked by relevance × the bandit's estimate of how
+    /// welcome that kind of suggestion is (Thompson sampling: some exploration).
+    pub fn suggest(&mut self, ctx: &SuggestContext) -> Vec<Suggestion> {
+        let mut out = Vec::new();
+        if !ctx.fields.is_empty() {
+            let mut charts = self.recommend_chart(&ctx.fields, 3);
+            charts.retain(|s| !matches!(&s.action, SuggestionAction::ChartType { kind } if Some(kind) == ctx.visual_kind.as_ref()));
+            out.extend(charts.into_iter().take(2));
+        }
+        if let Some(kind) = &ctx.visual_kind {
+            for h in self.model.prefs.habits(kind, 0.65, 3.0) {
+                if h.key == "theme" || ctx.current_format.get(&h.key) == Some(&h.value) {
+                    continue;
+                }
+                out.push(Suggestion {
+                    id: format!("format:{}={}", h.key, h.value),
+                    arm: "format".into(),
+                    title: format!("{} {}", key_label(&h.key), value_label(&h.value)),
+                    why: format!("You set {} to {} {:.0}% of the time{}.", key_label(&h.key).to_lowercase(), value_label(&h.value), h.share * 100.0, if h.scope == "*" { "" } else { " on this visual type" }),
+                    score: h.share * (1.0 - (-h.n / 4.0).exp()),
+                    action: SuggestionAction::Format { key: h.key, value: h.value },
+                });
+            }
+        }
+        if let Some(src) = &ctx.source_kind {
+            for (step, p) in self.model.sequences.predict(src, &ctx.last_steps).into_iter().take(3) {
+                out.push(Suggestion { id: format!("transform:{step}"), arm: "transform".into(), title: step.clone(), why: format!("Usually your next step on {src} data ({:.0}%).", p * 100.0), score: p, action: SuggestionAction::Transform { step } });
+            }
+        }
+        if let Some(m) = &ctx.measure {
+            for (pattern, n) in self.model.measures.top().into_iter().take(3) {
+                if n < 2.0 {
+                    continue;
+                }
+                if let Some((name, dax, format)) = self.model.measures.template(&pattern, m, ctx.date_column.as_deref()) {
+                    out.push(Suggestion { id: format!("measure:{name}"), arm: "measure".into(), title: format!("New measure: {name}"), why: format!("You often write {pattern} measures ({n:.0} so far)."), score: (n / 10.0).min(0.9), action: SuggestionAction::Measure { name, dax, format } });
+                }
+            }
+        }
+        if let Some(q) = &ctx.question {
+            for (it, s) in self.model.memory.recall(q, 2, None) {
+                out.push(Suggestion {
+                    id: format!("recall:{}", it.question),
+                    arm: "recall".into(),
+                    title: format!("Like \"{}\"", it.question),
+                    why: format!("You asked something similar before: {}", it.resolution.chars().take(80).collect::<String>()),
+                    score: (s / 10.0).min(0.95),
+                    action: SuggestionAction::Recall { question: it.question, resolution: it.resolution },
+                });
+            }
+        }
+        for s in out.iter_mut() {
+            let theta = self.model.bandit.sample(&s.arm, &mut self.rng);
+            s.score *= 0.5 + theta;
+        }
+        out.sort_by(|a, b| b.score.partial_cmp(&a.score).unwrap_or(std::cmp::Ordering::Equal));
+        out.truncate(if ctx.max == 0 { 4 } else { ctx.max });
+        out
+    }
+
+    /// A short description of this user's habits, added to the copilot's system prompt so a
+    /// cloud or local LLM personalises its answers too.
+    pub fn profile_summary(&self) -> String {
+        let m = &self.model;
+        if m.events < 3 {
+            return String::new();
+        }
+        let mut lines = vec![format!("About this user (learned on device from {} actions):", m.events)];
+        let mut by_ctx: Vec<(String, String, f64, f64)> = m
+            .charts
+            .counts
+            .iter()
+            .filter_map(|(ctx, c)| {
+                let n: f64 = c.values().sum();
+                let (k, v) = c.iter().max_by(|a, b| a.1.partial_cmp(b.1).unwrap_or(std::cmp::Ordering::Equal))?;
+                (n >= 2.0).then(|| (ctx.clone(), k.clone(), v / n, n))
+            })
+            .collect();
+        by_ctx.sort_by(|a, b| b.3.partial_cmp(&a.3).unwrap_or(std::cmp::Ordering::Equal));
+        for (ctx, k, share, n) in by_ctx.iter().take(4) {
+            lines.push(format!("- For {} they usually build a {} ({:.0}% of {n:.0}).", ctx.replace('+', " + "), kind_label(k).to_lowercase(), share * 100.0));
+        }
+        for h in m.prefs.habits("*", 0.65, 3.0).into_iter().take(5) {
+            lines.push(format!("- Formatting habit: {} = {}.", h.key, h.value));
+        }
+        for h in m.prefs.habits("report", 0.6, 2.0).into_iter().filter(|h| h.key == "theme") {
+            lines.push(format!("- Preferred theme: {}.", h.value));
+        }
+        let top: Vec<String> = m.measures.top().into_iter().take(3).map(|(p, n)| format!("{p} ({n:.0})")).collect();
+        if !top.is_empty() {
+            lines.push(format!("- DAX patterns they write: {}.", top.join(", ")));
+        }
+        let mut src: Vec<(&String, &f64)> = m.sequences.sources.iter().collect();
+        src.sort_by(|a, b| b.1.partial_cmp(a.1).unwrap_or(std::cmp::Ordering::Equal));
+        if !src.is_empty() {
+            lines.push(format!("- Data sources they use most: {}.", src.iter().take(3).map(|(k, _)| k.as_str()).collect::<Vec<_>>().join(", ")));
+        }
+        lines.push("Follow these habits when the user doesn't say otherwise.".into());
+        lines.join("\n")
+    }
+
+    /// The on-device decision backend, primed with this user's past choices.
+    pub fn decider(&self) -> LocalDecider {
+        let mut priors = self.model.decisions.clone();
+        // Chart-type questions also use the recommender's counts.
+        let chart: BTreeMap<String, f64> = self.model.charts.counts.values().flat_map(|m| m.iter()).fold(BTreeMap::new(), |mut acc, (k, v)| {
+            *acc.entry(k.clone()).or_default() += v;
+            acc
+        });
+        priors.entry("chart_type".into()).or_default().extend(chart);
+        LocalDecider { priors }
+    }
+
+    /// How sure the brain is about this user so far (0–1): grows with evidence.
+    pub fn maturity(&self) -> f64 {
+        1.0 - (-(self.model.events as f64) / 150.0).exp()
+    }
+}
+
+pub fn read_events(path: &std::path::Path) -> Vec<Event> {
+    std::fs::read_to_string(path).map(|t| t.lines().filter_map(|l| serde_json::from_str(l).ok()).collect()).unwrap_or_default()
+}
+
+/// "line" → "Line chart".
+pub fn kind_label(serde_name: &str) -> String {
+    serde_json::from_value::<vizcraft_core::doc::VisualKind>(serde_json::Value::String(serde_name.to_string())).map(|k| k.label().to_string()).unwrap_or_else(|_| serde_name.to_string())
+}
+
+fn key_label(key: &str) -> String {
+    match key {
+        "labels.show" => "Data labels".into(),
+        "legend.show" => "Legend".into(),
+        "legend.position" => "Legend position".into(),
+        "title.show" => "Title".into(),
+        "title.bold" => "Bold title".into(),
+        "title.size" => "Title size".into(),
+        "title.align" => "Title alignment".into(),
+        "border.show" => "Border".into(),
+        "shadow.show" => "Shadow".into(),
+        "markers.show" => "Markers".into(),
+        "grid.horizontal" => "Gridlines".into(),
+        "background.color" => "Background".into(),
+        k => k.replace('.', " "),
+    }
+}
+
+fn value_label(v: &str) -> String {
+    match v {
+        "true" => "on".into(),
+        "false" => "off".into(),
+        x => x.to_string(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
