+            b.record(EventKind::Suggestion { arm: "chart".into(), id: "y".into(), accepted: true });
+        }
+        let ctx = SuggestContext { fields: dm(), visual_kind: Some("table".into()), ..Default::default() };
+        let mut chart_first = 0;
+        for _ in 0..40 {
