+        ui.horizontal(|ui| {
+            ui.label(RichText::new(format!("{name} preview")).strong().size(11.5));
+            ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                if ui.add(egui::Button::new("✕").frame(false)).clicked() {
