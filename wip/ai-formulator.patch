+fn models_tab(app: &mut VizApp, ui: &mut Ui, t: &Tokens) {
+    if app.ai.hub.editing.is_empty() {
+        app.ai.hub.editing = if app.ai.settings.active.is_empty() { "anthropic".into() } else { app.ai.settings.active.clone() };
