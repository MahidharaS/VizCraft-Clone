+def _write(v, path):
+    if _PANDAS and isinstance(v, pd.DataFrame):
+        v.to_csv(path, index=False)
+        return True
+    if _PANDAS and isinstance(v, pd.Series):
+        v.to_frame().reset_index().to_csv(path, index=False)
+        return True
+    if isinstance(v, list) and v and isinstance(v[0], dict):
+        keys = list(v[0].keys())
