+
+/// JSON artifact (the registry format).
+pub fn to_json(m: &RegisteredModel) -> String {
+    serde_json::to_string_pretty(m).unwrap_or_else(|_| "{}".into())
+}
+
+/// A standalone Python 3 scoring script (standard library only) that reproduces the model's
+/// predictions: `python3 score.py input.csv > predictions.csv`.
+pub fn python_script(m: &RegisteredModel) -> String {
+    let payload = serde_json::json!({
+        "name": m.name, "version": m.version, "target": m.target, "classes": m.model.classes,
+        "encoder": m.model.encoder, "predictor": m.model.predictor,
+    });
+    let json = serde_json::to_string(&payload).unwrap_or_else(|_| "{}".into()).replace("'''", "\\u0027\\u0027\\u0027");
+    format!(
+        r#"#!/usr/bin/env python3
+"""Scoring script for the VizCraft model "{name}" v{version} ({algo}).
+
+Generated by VizCraft Data Science Studio. Standard library only.
+
+    python3 {file}.py input.csv > predictions.csv
+    python3 -c "import {file}; print({file}.predict({{'feature': 1.0}}))"
+"""
+import csv, json, math, sys
+
+MODEL = json.loads(r'''{json}''')
+ENC = MODEL["encoder"]
+P = MODEL["predictor"]
+CLASSES = MODEL["classes"]
+
+
+def _num(v):
+    try:
+        f = float(v)
+        return f if math.isfinite(f) else None
+    except (TypeError, ValueError):
+        return None
+
+
+def encode(row):
+    """Raw feature dict -> standardized vector (mean imputation, one-hot categories)."""
+    out = []
+    for f in ENC["features"]:
+        v = row.get(f["name"])
+        if f["type"] == "numeric":
+            x = _num(v)
+            out.append(f["fill"] if x is None else x)
+        else:
+            s = None if v is None or v == "" else str(v)
+            out.extend(1.0 if s == lvl else 0.0 for lvl in f["levels"])
+    return [(x - m) / (s if s > 0 else 1.0) for x, m, s in zip(out, ENC["mean"], ENC["std"])]
+
+
+def _affine(w, x):
+    return w[0] + sum(a * b for a, b in zip(w[1:], x))
+
+
+def _softmax(z):
+    m = max(z)
+    e = [math.exp(v - m) for v in z]
+    s = sum(e) or 1e-300
+    return [v / s for v in e]
+
+
+def _sigmoid(z):
+    z = max(-40.0, min(40.0, z))
+    return 1.0 / (1.0 + math.exp(-z))
+
+
+def _tree(nodes, x):
+    i = 0
+    while True:
+        n = nodes[i]
+        if n["n"] == "leaf":
+            return n["v"]
+        i = n["l"] if (x[n["f"]] if n["f"] < len(x) else 0.0) <= n["t"] else n["r"]
+
+
+def _argmax(v):
+    return max(range(len(v)), key=lambda i: (v[i], -i)) if v else 0
+
+
+def _act(name, v):
+    if name == "tanh":
+        return math.tanh(v)
+    if name == "logistic":
+        return _sigmoid(v)
+    if name == "identity":
+        return v
+    return max(v, 0.0)
+
+
+def raw_predict(x):
+    """Standardized vector -> (value or class index, probabilities)."""
+    t = P["type"]
+    k = len(CLASSES)
+    if t == "linear":
+        return P["intercept"] + sum(a * b for a, b in zip(P["coef"], x)), []
+    if t == "logistic":
+        probs = _softmax([_affine(w, x) for w in P["w"]])
+    elif t == "tree":
+        v = _tree(P["nodes"], x)
+        if k == 0:
+            return v[0], []
+        probs = list(v)
+    elif t == "forest":
+        outs = [_tree(tr, x) for tr in P["trees"]]
+        if k == 0:
+            return sum(o[0] for o in outs) / len(outs), []
+        probs = [sum(o[c] for o in outs) / len(outs) for c in range(k)]
+    elif t == "gbm":
+        f = list(P["init"])
+        for stage in P["stages"]:
+            for j, tr in enumerate(stage):
+                f[j] += P["rate"] * _tree(tr, x)[0]
+        if k == 0:
+            return f[0], []
+        if k == 2 and len(f) == 1:
+            p = _sigmoid(f[0])
+            probs = [1 - p, p]
+        else:
+            p = [_sigmoid(v) for v in f]
+            s = sum(p) or 1e-12
+            probs = [v / s for v in p]
+    elif t == "adaBoost":
+        if k == 0:
+            preds = sorted((_tree(tr, x)[0], a) for tr, a in zip(P["trees"], P["alphas"]))
+            total, acc = sum(a for _, a in preds), 0.0
+            for v, a in preds:
+                acc += a
+                if acc >= total / 2:
+                    return v, []
+            return preds[-1][0], []
+        votes = [0.0] * k
+        for tr, a in zip(P["trees"], P["alphas"]):
+            votes[_argmax(_tree(tr, x))] += a
+        probs = _softmax([v / max(k - 1, 1) for v in votes])
+    elif t == "svm":
+        d = [_affine(w, x) for w in P["w"]]
+        if k == 0:
+            return d[0], []
+        if k == 2 and len(d) == 1:
+            p = _sigmoid(P["scale"] * d[0])
+            probs = [1 - p, p]
+        else:
+            probs = _softmax([v * P["scale"] for v in d])
+    elif t == "mlp":
+        a = x
+        layers = P["layers"]
+        for li, layer in enumerate(layers):
+            z = [b + sum(wi * ai for wi, ai in zip(row, a)) for row, b in zip(layer["w"], layer["b"])]
+            a = z if li == len(layers) - 1 else [_act(P["activation"], v) for v in z]
+        if k == 0:
+            return a[0] * P["y_std"] + P["y_mean"], []
+        probs = _softmax(a)
+    elif t == "naiveBayes":
+        logs = []
+        for c in range(k):
+            lp = math.log(max(P["prior"][c], 1e-12))
+            for j, v in enumerate(x):
+                m, s2 = P["mean"][c][j], max(P["var"][c][j], 1e-9)
+                lp += -0.5 * ((v - m) ** 2 / s2 + math.log(2 * math.pi * s2))
+            logs.append(lp)
+        probs = _softmax(logs)
+    elif t == "knn":
+        d = sorted((sum((a - b) ** 2 for a, b in zip(r, x)), i) for i, r in enumerate(P["x"]))[: max(1, P["k"])]
+        wt = (lambda dd: 1.0 / (math.sqrt(dd) + 1e-9)) if P["distance_weighted"] else (lambda dd: 1.0)
+        if k == 0:
+            ws = sum(wt(dd) for dd, _ in d)
+            return sum(wt(dd) * P["y"][i] for dd, i in d) / ws, []
+        acc = [0.0] * k
+        for dd, i in d:
+            acc[int(P["y"][i])] += wt(dd)
+        s = sum(acc) or 1e-300
+        probs = [v / s for v in acc]
+    else:
+        raise ValueError("unsupported model type " + t)
+    return _argmax(probs), probs
+
+
+def predict(row):
+    """Feature dict -> prediction (class label or number) and class probabilities."""
+    v, probs = raw_predict(encode(row))
+    if CLASSES:
+        return CLASSES[v], dict(zip(CLASSES, probs))
+    return v, {{}}
+
+
+def main():
+    src = open(sys.argv[1], newline="", encoding="utf-8") if len(sys.argv) > 1 else sys.stdin
+    rows = csv.DictReader(src)
+    out = csv.writer(sys.stdout)
+    header = ["prediction"] + ["P(%s)" % c for c in CLASSES]
+    out.writerow(header)
+    for row in rows:
+        label, probs = predict(row)
+        out.writerow([label] + [repr(probs[c]) for c in CLASSES])
+
+
+if __name__ == "__main__":
+    main()
+"#,
+        name = m.name,
+        version = m.version,
+        algo = m.algorithm,
+        file = python_ident(&m.name),
+        json = json
+    )
+}
+
+pub fn python_ident(name: &str) -> String {
+    let s: String = name.chars().map(|c| if c.is_ascii_alphanumeric() { c.to_ascii_lowercase() } else { '_' }).collect();
+    let s = s.trim_matches('_').to_string();
+    if s.is_empty() || s.starts_with(|c: char| c.is_ascii_digit()) { format!("model_{s}") } else { format!("score_{s}") }
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+    use crate::studio::learn::{self, tests_support::sample, LearnerSpec};
+
+    #[test]
+    fn registry_drift_and_python_export() {
+        let t = sample(200);
+        let feats = vec!["a".to_string(), "b".into(), "c".into()];
+        let mut shifted = t.clone();
+        for r in shifted.rows.iter_mut() {
+            if let Scalar::Num(v) = &mut r[0] {
+                *v += 3.0;
+            }
+        }
+        for kind in ["logistic", "tree", "forest", "gbm", "adaboost", "svm", "mlp", "naive_bayes", "knn"] {
+            let m = learn::fit(&LearnerSpec { kind: kind.into(), ..Default::default() }, &t, &feats, "label").unwrap();
+            let mut rm = register("churn", &m, &t, BTreeMap::new(), "test", "");
+            rm.version = next_version(&[], "churn");
+            assert_eq!(rm.version, 1);
+            let d = drift(&rm, &t);
+            assert!(d.iter().all(|r| r.psi < 0.1), "{kind}: {:?}", d.iter().map(|r| r.psi).collect::<Vec<_>>());
+            let d2 = drift(&rm, &shifted);
+            assert!(d2[0].psi > 0.25 && d2[0].ks_p < 0.001, "{:?}", d2[0]);
+            // Round trip.
+            let back: RegisteredModel = serde_json::from_str(&to_json(&rm)).unwrap();
+            assert_eq!(back.model.predict_table(&t), m.predict_table(&t));
+            // Python reproduces the predictions (when python3 is available).
+            check_python(&rm, &t);
+        }
+        let m = learn::fit(&LearnerSpec { kind: "gbm".into(), ..Default::default() }, &t, &feats, "y").unwrap();
+        let rm = register("y", &m, &t, BTreeMap::new(), "test", "");
+        check_python(&rm, &t);
+    }
+
+    fn check_python(rm: &RegisteredModel, t: &TableData) {
+        let Ok(dir) = std::env::var("CARGO_TARGET_TMPDIR").or_else(|_| std::env::temp_dir().into_os_string().into_string()) else { return };
+        let script = std::path::Path::new(&dir).join(format!("vc_score_{}_{}.py", rm.model.spec.kind, std::process::id()));
+        let csv_path = script.with_extension("csv");
+        std::fs::write(&script, python_script(rm)).unwrap();
+        std::fs::write(&csv_path, crate::flow::write_csv(t, ',')).unwrap();
+        let Ok(out) = std::process::Command::new("python3").arg(&script).arg(&csv_path).output() else { return };
+        assert!(out.status.success(), "{}", String::from_utf8_lossy(&out.stderr));
+        let text = String::from_utf8_lossy(&out.stdout);
+        let preds = rm.model.predict_table(t);
+        for (line, (v, _)) in text.lines().skip(1).zip(&preds) {
+            let first = line.split(',').next().unwrap();
+            if rm.model.is_classifier() {
+                assert_eq!(first, rm.model.classes[*v as usize], "{}", rm.model.spec.kind);
+            } else {
+                assert!((first.parse::<f64>().unwrap() - v).abs() < 1e-6 * v.abs().max(1.0));
+            }
+        }
+        let _ = std::fs::remove_file(script);
+        let _ = std::fs::remove_file(csv_path);
+    }
+}
diff --git a/vizcraft/crates/core/src/studio/unsup.rs b/vizcraft/crates/core/src/studio/unsup.rs
new file mode 100644
index 0000000..6e626c4
--- /dev/null
+++ b/vizcraft/crates/core/src/studio/unsup.rs
@@ -0,0 +1,363 @@
+//! Unsupervised methods for the Studio: agglomerative clustering with the full merge history
+//! (single / complete / average / Ward linkage, Lance–Williams updates) for dendrograms,
+//! per-sample silhouette scores, classical multidimensional scaling (power iteration) and exact
+//! t-SNE (perplexity calibration, early exaggeration, momentum gradient descent).
+
+use crate::ml::{Matrix, Rng};
+
+pub fn euclid(a: &[f64], b: &[f64]) -> f64 {
+    a.iter().zip(b).map(|(x, y)| (x - y) * (x - y)).sum::<f64>().sqrt()
+}
+
+pub fn distance_matrix(x: &Matrix) -> Matrix {
+    let n = x.len();
+    let mut d = vec![vec![0.0; n]; n];
+    for i in 0..n {
+        for j in i + 1..n {
+            let v = euclid(&x[i], &x[j]);
+            d[i][j] = v;
+            d[j][i] = v;
+        }
+    }
+    d
+}
+
+/// One merge: clusters `a` and `b` (ids < n are leaves, ≥ n are earlier merges) at `height`.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Merge {
+    pub a: usize,
+    pub b: usize,
+    pub height: f64,
+    pub size: usize,
+}
+
+/// Agglomerative clustering; returns n − 1 merges (SciPy `linkage` order).
+pub fn linkage(x: &Matrix, method: &str) -> Vec<Merge> {
+    let n = x.len();
+    if n < 2 {
+        return vec![];
+    }
+    let mut d = distance_matrix(x);
+    if method == "ward" {
+        for r in d.iter_mut() {
+            for v in r.iter_mut() {
+                *v = *v * *v;
+            }
+        }
+    }
+    let mut active: Vec<bool> = vec![true; n];
+    let mut id: Vec<usize> = (0..n).collect();
+    let mut size: Vec<usize> = vec![1; n];
+    let mut merges = Vec::with_capacity(n - 1);
+    for step in 0..n - 1 {
+        let mut best = (f64::INFINITY, 0, 0);
+        for i in 0..n {
+            if !active[i] {
+                continue;
+            }
+            for j in i + 1..n {
+                if active[j] && d[i][j] < best.0 {
+                    best = (d[i][j], i, j);
+                }
+            }
+        }
+        let (h, i, j) = best;
+        if !h.is_finite() {
+            break;
+        }
+        let (si, sj) = (size[i] as f64, size[j] as f64);
+        for k in 0..n {
+            if !active[k] || k == i || k == j {
+                continue;
+            }
+            let sk = size[k] as f64;
+            let v = match method {
+                "single" => d[i][k].min(d[j][k]),
+                "complete" => d[i][k].max(d[j][k]),
+                "ward" => ((si + sk) * d[i][k] + (sj + sk) * d[j][k] - sk * d[i][j]) / (si + sj + sk),
+                _ => (si * d[i][k] + sj * d[j][k]) / (si + sj),
+            };
+            d[i][k] = v;
+            d[k][i] = v;
+        }
+        active[j] = false;
+        merges.push(Merge { a: id[i].min(id[j]), b: id[i].max(id[j]), height: if method == "ward" { h.max(0.0).sqrt() } else { h }, size: size[i] + size[j] });
+        size[i] += size[j];
+        id[i] = n + step;
+    }
+    merges
+}
+
+/// Cluster labels (0..k) from a linkage cut into `k` clusters.
+pub fn cut(merges: &[Merge], n: usize, k: usize) -> Vec<usize> {
+    let k = k.clamp(1, n.max(1));
+    let mut parent: Vec<usize> = (0..n + merges.len()).collect();
+    fn find(p: &mut [usize], mut x: usize) -> usize {
+        while p[x] != x {
+            p[x] = p[p[x]];
+            x = p[x];
+        }
+        x
+    }
+    for (s, m) in merges.iter().enumerate().take(n.saturating_sub(k)) {
+        let node = n + s;
+        let (ra, rb) = (find(&mut parent, m.a), find(&mut parent, m.b));
+        parent[ra] = node;
+        parent[rb] = node;
+    }
+    let mut roots: Vec<usize> = vec![];
+    let mut labels = vec![0; n];
+    for (i, l) in labels.iter_mut().enumerate() {
+        let r = find(&mut parent, i);
+        let pos = match roots.iter().position(|x| *x == r) {
+            Some(p) => p,
+            None => {
+                roots.push(r);
+                roots.len() - 1
+            }
+        };
+        *l = pos;
+    }
+    labels
+}
+
+/// Leaf order for drawing a dendrogram without crossings.
+pub fn leaf_order(merges: &[Merge], n: usize) -> Vec<usize> {
+    if n == 0 {
+        return vec![];
+    }
+    if merges.is_empty() {
+        return (0..n).collect();
+    }
+    let root = n + merges.len() - 1;
+    let mut out = vec![];
+    let mut stack = vec![root];
+    while let Some(v) = stack.pop() {
+        if v < n {
+            out.push(v);
+        } else if let Some(m) = merges.get(v - n) {
+            stack.push(m.b);
+            stack.push(m.a);
+        }
+    }
+    out
+}
+
+/// Silhouette value of every sample (0 for singletons).
+pub fn silhouettes(x: &Matrix, labels: &[usize]) -> Vec<f64> {
+    let n = x.len().min(labels.len());
+    let k = labels.iter().copied().max().map(|m| m + 1).unwrap_or(0);
+    let mut out = vec![0.0; n];
+    let sizes: Vec<usize> = (0..k).map(|c| labels.iter().take(n).filter(|l| **l == c).count()).collect();
+    for i in 0..n {
+        let mut sum = vec![0.0; k];
+        for j in 0..n {
+            if i != j {
+                sum[labels[j]] += euclid(&x[i], &x[j]);
+            }
+        }
+        let own = labels[i];
+        if sizes[own] <= 1 {
+            continue;
+        }
+        let a = sum[own] / (sizes[own] - 1) as f64;
+        let b = (0..k).filter(|c| *c != own && sizes[*c] > 0).map(|c| sum[c] / sizes[c] as f64).fold(f64::INFINITY, f64::min);
+        out[i] = if b.is_finite() { (b - a) / a.max(b).max(1e-300) } else { 0.0 };
+    }
+    out
+}
+
+/// Classical (Torgerson) MDS to `dims` dimensions.
+pub fn mds(x: &Matrix, dims: usize, seed: u64) -> Matrix {
+    let n = x.len();
+    if n < 2 {
+        return vec![vec![0.0; dims]; n];
+    }
+    let d = distance_matrix(x);
+    // B = −½ J D² J
+    let d2: Matrix = d.iter().map(|r| r.iter().map(|v| v * v).collect()).collect();
+    let rm: Vec<f64> = d2.iter().map(|r| r.iter().sum::<f64>() / n as f64).collect();
+    let gm = rm.iter().sum::<f64>() / n as f64;
+    let b: Matrix = (0..n).map(|i| (0..n).map(|j| -0.5 * (d2[i][j] - rm[i] - rm[j] + gm)).collect()).collect();
+    let mut rng = Rng::new(seed);
+    let mut vecs: Vec<(f64, Vec<f64>)> = vec![];
+    for _ in 0..dims {
+        let mut v: Vec<f64> = (0..n).map(|_| rng.f64() - 0.5).collect();
+        let mut lambda = 0.0;
+        for _ in 0..300 {
+            let mut w: Vec<f64> = b.iter().map(|r| r.iter().zip(&v).map(|(a, c)| a * c).sum()).collect();
+            for (l, u) in &vecs {
+                let p: f64 = u.iter().zip(&w).map(|(a, c)| a * c).sum();
+                let _ = l;
+                for (wi, ui) in w.iter_mut().zip(u) {
+                    *wi -= p * ui;
+                }
+            }
+            let norm = w.iter().map(|a| a * a).sum::<f64>().sqrt();
+            if norm <= 1e-300 {
+                break;
+            }
+            let nv: Vec<f64> = w.iter().map(|a| a / norm).collect();
+            let diff: f64 = nv.iter().zip(&v).map(|(a, c)| (a - c).abs()).sum();
+            v = nv;
+            lambda = norm;
+            if diff < 1e-10 {
+                break;
+            }
+        }
+        vecs.push((lambda, v));
+    }
+    (0..n).map(|i| vecs.iter().map(|(l, v)| v[i] * l.max(0.0).sqrt()).collect()).collect()
+}
+
+/// Exact t-SNE to 2-D.
+pub fn tsne(x: &Matrix, perplexity: f64, iterations: usize, seed: u64) -> Matrix {
+    let n = x.len();
+    if n < 4 {
+        return (0..n).map(|i| vec![i as f64, 0.0]).collect();
+    }
+    let perp = perplexity.clamp(2.0, ((n - 1) as f64 / 3.0).max(2.0));
+    let d2: Matrix = (0..n).map(|i| (0..n).map(|j| x[i].iter().zip(&x[j]).map(|(a, b)| (a - b) * (a - b)).sum()).collect()).collect();
+    // Conditional probabilities with binary search on the precision.
+    let target = perp.ln();
+    let mut p = vec![vec![0.0; n]; n];
+    for i in 0..n {
+        let (mut beta, mut lo, mut hi) = (1.0f64, 0.0f64, f64::INFINITY);
+        let mind = (0..n).filter(|j| *j != i).map(|j| d2[i][j]).fold(f64::INFINITY, f64::min);
+        for _ in 0..60 {
+            let mut sum = 0.0;
+            let mut hsum = 0.0;
+            for j in 0..n {
+                if j != i {
+                    let v = (-(d2[i][j] - mind) * beta).exp();
+                    p[i][j] = v;
+                    sum += v;
+                    hsum += v * (d2[i][j] - mind);
+                }
+            }
+            let sum = sum.max(1e-300);
+            let h = sum.ln() + beta * hsum / sum;
+            for j in 0..n {
+                p[i][j] /= sum;
+            }
+            if (h - target).abs() < 1e-5 {
+                break;
+            }
+            if h > target {
+                lo = beta;
+                beta = if hi.is_finite() { (beta + hi) / 2.0 } else { beta * 2.0 };
+            } else {
+                hi = beta;
+                beta = (beta + lo) / 2.0;
+            }
+        }
+    }
+    // Symmetrize.
+    let mut pj = vec![vec![0.0; n]; n];
+    for i in 0..n {
+        for j in 0..n {
+            pj[i][j] = ((p[i][j] + p[j][i]) / (2.0 * n as f64)).max(1e-12);
+        }
+    }
+    let mut rng = Rng::new(seed);
+    let mut y: Matrix = (0..n).map(|_| vec![(rng.f64() - 0.5) * 1e-2, (rng.f64() - 0.5) * 1e-2]).collect();
+    let mut vel = vec![vec![0.0; 2]; n];
+    let mut gains = vec![vec![1.0; 2]; n];
+    let iters = iterations.clamp(50, 2000);
+    let eta = (n as f64 / 12.0).max(50.0);
+    let mut q = vec![vec![0.0; n]; n];
+    for it in 0..iters {
+        let exag = if it < 100 { 12.0 } else { 1.0 };
+        let mom = if it < 120 { 0.5 } else { 0.8 };
+        let mut qsum = 0.0;
+        for i in 0..n {
+            for j in i + 1..n {
+                let dx = y[i][0] - y[j][0];
+                let dy = y[i][1] - y[j][1];
+                let v = 1.0 / (1.0 + dx * dx + dy * dy);
+                q[i][j] = v;
+                q[j][i] = v;
+                qsum += 2.0 * v;
+            }
+        }
+        let qsum = qsum.max(1e-300);
+        for i in 0..n {
+            let mut g = [0.0, 0.0];
+            for j in 0..n {
+                if i == j {
+                    continue;
+                }
+                let m = (exag * pj[i][j] - q[i][j] / qsum) * q[i][j];
+                g[0] += 4.0 * m * (y[i][0] - y[j][0]);
+                g[1] += 4.0 * m * (y[i][1] - y[j][1]);
+            }
+            for c in 0..2 {
+                gains[i][c] = if (g[c] > 0.0) != (vel[i][c] > 0.0) { gains[i][c] + 0.2 } else { (gains[i][c] * 0.8f64).max(0.01) };
+                vel[i][c] = mom * vel[i][c] - eta * gains[i][c] * g[c];
+            }
+        }
+        for i in 0..n {
+            y[i][0] += vel[i][0];
+            y[i][1] += vel[i][1];
+        }
+        // Re-centre.
+        let (mx, my) = (y.iter().map(|r| r[0]).sum::<f64>() / n as f64, y.iter().map(|r| r[1]).sum::<f64>() / n as f64);
+        for r in y.iter_mut() {
+            r[0] -= mx;
+            r[1] -= my;
+        }
+    }
+    y
+}
+
+#[cfg(test)]
+#[allow(clippy::unwrap_used)]
+mod tests {
+    use super::*;
+
+    fn blobs() -> Matrix {
+        let mut rng = Rng::new(5);
+        let mut x = vec![];
+        for (cx, cy) in [(0.0, 0.0), (8.0, 8.0), (0.0, 8.0)] {
+            for _ in 0..20 {
+                x.push(vec![cx + rng.f64(), cy + rng.f64()]);
+            }
+        }
+        x
+    }
+
+    #[test]
+    fn linkage_reference() {
+        // SciPy linkage([[0],[1],[5],[6],[20]], 'single') heights: 1, 1, 4, 14.
+        let x: Matrix = [0.0, 1.0, 5.0, 6.0, 20.0].iter().map(|v| vec![*v]).collect();
+        let m = linkage(&x, "single");
+        let h: Vec<f64> = m.iter().map(|m| m.height).collect();
+        assert_eq!(h, vec![1.0, 1.0, 4.0, 14.0]);
+        let c = cut(&m, 5, 3);
+        assert_eq!(c[0], c[1]);
+        assert_eq!(c[2], c[3]);
+        assert_ne!(c[0], c[4]);
+        // Ward on two points: height = distance.
+        let w = linkage(&vec![vec![0.0], vec![3.0]], "ward");
+        assert!((w[0].height - 3.0).abs() < 1e-12);
+        assert_eq!(leaf_order(&m, 5).len(), 5);
+    }
+
+    #[test]
+    fn silhouette_and_embeddings() {
+        let x = blobs();
+        let labels: Vec<usize> = (0..60).map(|i| i / 20).collect();
+        let s = silhouettes(&x, &labels);
+        assert!(s.iter().sum::<f64>() / 60.0 > 0.8);
+        let m = mds(&x, 2, 1);
+        // MDS preserves distances for 2-D data.
+        let d0 = euclid(&x[0], &x[30]);
+        let d1 = euclid(&m[0], &m[30]);
+        assert!((d0 - d1).abs() < 1e-6 * d0.max(1.0), "{d0} {d1}");
+        let t = tsne(&x, 10.0, 300, 1);
+        // Points of one blob stay closer than points of different blobs.
+        let within = euclid(&t[0], &t[1]);
+        let across = euclid(&t[0], &t[25]);
+        assert!(within < across, "{within} {across}");
+    }
+}
