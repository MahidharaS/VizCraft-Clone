+        w("stats.acf", "Autocorrelation", Statistics, "ACF and PACF with significance bands.", d_in(), vec![], vec![col("value", "Series", Numeric), int("lags", "Lags", 1, 200, 24), int("diff", "Differencing", 0, 2, 0)]),
+        w(
+            "stats.arima",
