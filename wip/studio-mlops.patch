+        let r = paste(&mut s, &[vec!["=A1".to_string()]], (5, 0), Range::new((5, 0), (6, 1)), Some((0, 0)));
+        assert_eq!(r, Range { r1: 5, c1: 0, r2: 6, c2: 1 });
+        assert_eq!(get(&s, 6, 1), "=B7");
+    }
+}
