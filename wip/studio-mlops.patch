+    let Some(cache) = &st.cache else { return };
+    let (r, c) = st.cursor;
+    let keep = super::display_value(s, &cache.values, r, c);
+    let mut hidden = std::collections::BTreeSet::new();
+    for row in 1..s.cells.len() {
+        let v = super::display_value(s, &cache.values, row, c);
+        if v != keep {
+            hidden.insert(v);
+        }
+    }
