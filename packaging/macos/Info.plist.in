<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/make-dmg.sh substitutes @VERSION@ and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>VizardCraft</string>
  <key>CFBundleName</key>
  <string>VizardCraft</string>
  <key>CFBundleExecutable</key>
  <string>VizardCraft</string>
  <key>CFBundleIdentifier</key>
  <string>com.vizardcraft.app</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>VizardCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>VizardCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.business</string>
  <!-- Keep in sync with MACOSX_DEPLOYMENT_TARGET in make-dmg.sh. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the VizardCraft authors. MIT OR Apache-2.0.</string>

  <!-- VizardCraft projects: .vizc (single file) and .vizp (Git-friendly folder project pointer). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>VizardCraft Project</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array><string>com.vizardcraft.project</string></array>
      <key>CFBundleTypeIconFile</key>
      <string>VizardCraft</string>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.vizardcraft.project</string>
      <key>UTTypeDescription</key>
      <string>VizardCraft Project</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.json</string>
        <string>public.data</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>VizardCraft</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>vizc</string><string>vizp</string></array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
